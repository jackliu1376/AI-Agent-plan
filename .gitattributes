# 统一行尾，避免 Windows / macOS / Linux 之间的换行符噪音
* text=auto eol=lf

# Windows 脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.db binary

# 生成的索引：单行一条记录，diff 时按行看更清晰
*.tsv text eol=lf

# 锁文件：GitHub 上折叠显示
uv.lock linguist-generated=true
mcp_server/data/city_index.tsv linguist-generated=true
