# ============================================================
# 密钥 —— 绝不提交
# ============================================================
.env
.env.local
.env.*.local
!.env.example

# ============================================================
# Python
# ============================================================
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ============================================================
# 运行时产物（可重建）
# ============================================================
task-planner/outputs/*
!task-planner/outputs/.gitkeep

# 景点库：由 seed.py 自动重建
task-planner/mcp_server/data/attractions.db

# GeoNames 原始数据包（3.3MB）：用 build_city_index.py 重新下载
task-planner/mcp_server/data/.cache/

# ============================================================
# Agent 工作记忆（内部笔记，不公开）
# ============================================================
.workbuddy-ai/

# ============================================================
# 前端
# ============================================================
node_modules/
frontend/dist/
frontend/.vite/
*.local

# 前端构建产物 —— 这一项刻意「不」忽略：
# web/static/ 随仓库提交，因此用户不需要 Node 环境就能跑网页版。
# 改前端后执行 `cd frontend && npm run build` 重新生成即可。

