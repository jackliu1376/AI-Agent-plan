# ---- LLM（DeepSeek，OpenAI 兼容接口）----
# ⚠️ 本文件会被提交到 git，只放占位符，绝不填写真实 Key。
#    真实 Key 请写在 .env（已被 .gitignore 忽略）。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ⚠️ 必须填 OpenAI 兼容端点。
#    不要填 https://api.deepseek.com/anthropic
#    —— 那是 Anthropic 兼容端点（供 Claude Code 等工具使用），
#       本项目的 SDK 会在其后拼接 /chat/completions，填了会返回 404。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Agent 运行时护栏 ----
# 编排循环最大轮次（防止死循环烧 token）
MAX_TURNS=8
# 单次会话工具调用总预算
TOOL_BUDGET=12
# 单次工具调用超时（秒）
TOOL_TIMEOUT=10
# 工具失败自动重试次数
TOOL_RETRIES=1

# ---- 工具可选外部依赖 ----
# 汇率 API（留空则使用内置离线汇率表兜底）
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest

# 高德 Web 服务 API Key（可选，仅用于「驾车」模式的实时路线）
#
# 申请：https://console.amap.com/dev/key/app （选「Web服务」类型）
# 配额：个人开发者 10,000 次/月、2 QPS，超限返回错误码 10023
#
# 合规：路径规划接口的适用场景明确包含「无需展现地图的场景」，因此用于
#       文本行程规划是被允许的；但服务协议禁止存储/缓存其数据，
#       本项目只在当次会话内使用，**不写入本地库**。
#
# 留空则驾车模式自动降级为离线估算（行为与不配置时完全一致）。
AMAP_API_KEY=

# ---- Web / 桌面版 ----
# 会话落盘：把每次会话（含完整事件与计划）写进 logs/sessions.db，
# 于是服务重启后侧栏「最近」里的记录依然打得开。
# 设为 0 可关闭，行为退回纯内存（重启即丢）。
SESSION_DB_ENABLED=1
# 会话库位置（相对路径基于项目根目录）
SESSION_DB_PATH=logs/sessions.db

# ---- 本地路径 ----
# 计划落盘目录（save_itinerary 的沙箱根目录，禁止越界写入）
OUTPUT_DIR=outputs
# 景点数据库路径（留空则用 mcp_server/data/attractions.db）
ATTRACTIONS_DB=
