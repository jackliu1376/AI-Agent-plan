# ---- LLM（OpenAI 兼容接口）----
# ⚠️ 本文件会被提交到 git，只放占位符，绝不填写真实 Key。
#    真实 Key 请写在 .env（已被 .gitignore 忽略）。
#
# 本项目用标准 OpenAI SDK + tools 调用，所以**任何「OpenAI 兼容 + 支持
# function calling」的服务都能用**。改下面三个变量即可换模型，代码不用动。
# （变量名叫 DEEPSEEK_* 只是历史原因，与功能无关。）
#
# 已验证的接入参数：
#   DeepSeek    https://api.deepseek.com                  deepseek-chat
#   小米 MiMo    https://api.xiaomimimo.com/v1             mimo-v2.6-pro
#   智谱 GLM     https://open.bigmodel.cn/api/paas/v4      glm-5.3
#                （GLM 的 temperature 上限是 1.0，别把 LLM_TEMPERATURE 调过 1）
#
# 换模型前**先跑评测对比**：python scripts/eval_model.py --list
# 不同模型的工具调用能力和 schema 遵循度差别很大，尤其「注入抵抗」那一类
# 完全靠模型自身，编排层兜不住。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ⚠️ 必须填 OpenAI 兼容端点。
#    不要填 https://api.deepseek.com/anthropic
#    —— 那是 Anthropic 兼容端点（供 Claude Code 等工具使用），
#       本项目的 SDK 会在其后拼接 /chat/completions，填了会返回 404。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Agent 运行时护栏 ----
# 编排循环最大轮次（防止死循环烧 token）
MAX_TURNS=8
# 单次会话工具调用总预算
TOOL_BUDGET=12
# 单次工具调用超时（秒）
TOOL_TIMEOUT=10
# 工具失败自动重试次数
TOOL_RETRIES=1

# ---- 工具可选外部依赖 ----
# 汇率 API（留空则使用内置离线汇率表兜底）
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest

# 高德 Web 服务 API Key（可选，仅用于「驾车」模式的实时路线）
#
# 申请：https://console.amap.com/dev/key/app （选「Web服务」类型）
# 配额：个人开发者 10,000 次/月、2 QPS，超限返回错误码 10023
#
# 合规：路径规划接口的适用场景明确包含「无需展现地图的场景」，因此用于
#       文本行程规划是被允许的；但服务协议禁止存储/缓存其数据，
#       本项目只在当次会话内使用，**不写入本地库**。
#
# 留空则驾车模式自动降级为离线估算（行为与不配置时完全一致）。
AMAP_API_KEY=

# 高德 JS API Key（可选，用于计划页的「行程地图」）
#
# ⚠️ 这是**另一种 key 类型**，与上面的 AMAP_API_KEY 不能互换：
#    - AMAP_API_KEY   「Web服务」类型 —— 服务端 HTTP 调用（路线、POI 搜索）
#    - AMAP_JS_KEY    「Web端(JS API)」类型 —— 浏览器里渲染地图
#    在控制台同一个应用下可以同时申请两个，但要分别勾选服务平台。
#
# 申请：https://console.amap.com/dev/key/app
#      服务平台选「Web端(JS API)」，并在「域名白名单」里加上 localhost
#
# 安全密钥：JS API 2.0 起必须配套 securityJsCode（与 key 同时生成）。
#   留空会导致地图加载报 INVALID_USER_SCODE，此时前端降级为自绘示意图。
#
# 合规：POI 搜索走 Web 服务接口、地图展现走 JS API，两者在同一高德生态内，
#       符合「配合高德地图使用」的约定。但服务协议仍禁止存储 POI 数据，
#       因此坐标只存在于会话内存中，**不写 sessions.db**。
#
# 未配置时地图组件自动降级为 SVG 相对位置示意图（无街道底图），功能不受影响。
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=

# 安全密钥的代理前缀。**部署到公网时设成 `/_AMapService`**。
#
# 留空 = 上面的 AMAP_JS_SECURITY_CODE 会被明文下发给浏览器。
#        高德官方明确不建议在生产环境这么做。本地开发没有 Nginx，
#        只能这样，所以默认留空。
#
# 设成 `/_AMapService` 后，后端不再返回密钥本身，前端只往这个前缀转发，
# 由 Nginx 在服务端拼上 jscode（片段由 deploy/bootstrap.sh 生成）。
# 浏览器拿不到密钥，即使 key 泄露也无法脱离你的域名使用。
#
# ⚠️ 只在有 Nginx 的环境生效。本地 `npm run dev` 时设了它会导致地图
#    加载失败（Vite 没有这个代理），本地调试请保持留空。
AMAP_SERVICE_HOST=

# ---- Web / 桌面版 ----
# 会话落盘：把每次会话（含完整事件与计划）写进 logs/sessions.db，
# 于是服务重启后侧栏「最近」里的记录依然打得开。
# 设为 0 可关闭，行为退回纯内存（重启即丢）。
SESSION_DB_ENABLED=1
# 会话库位置（相对路径基于项目根目录）
SESSION_DB_PATH=logs/sessions.db

# ---- Web 监听（部署到服务器时用）----
# 本地开发保持默认值即可，不用改。
#
# 部署到公网时：
#   WEB_HOST=127.0.0.1   只监听回环，外部一律经 Nginx。**不要填 0.0.0.0**，
#                        那样 8000 端口会直接暴露，绕过 TLS 和限流。
#   WEB_TRUST_PROXY=1    采信 Nginx 传来的 X-Forwarded-For。
#                        不设的话限流会把所有用户算成同一个 IP（127.0.0.1），
#                        一个人就能吃光全站额度。前提是确实前置了可信代理 ——
#                        这个头可以伪造，直连公网时不要开。
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_TRUST_PROXY=0

# 访问令牌。**留空 = 不鉴权**（本地开发默认，行为与加这个功能之前完全一致）。
#
# 部署到公网必须设置：否则任何知道地址的人都能提交任务（烧你的模型余额）、
# 列出全部历史会话（含任务原文与生成的计划）、删除你的会话。
# 限流只防刷不防用 —— 10 次真实任务足够产生账单。
#
# 生成一个：openssl rand -base64 24
#
# 设置后浏览器首次打开会要求输入这个令牌，换取一个 HttpOnly cookie（7 天）。
# 换掉这个值会让所有已登录的浏览器失效。
WEB_ACCESS_TOKEN=

# 限流：窗口内允许的请求数（单机内存实现，多进程会各算各的）
WEB_RATE_LIMIT=10

# ---- 本地路径 ----
# 计划落盘目录（save_itinerary 的沙箱根目录，禁止越界写入）
OUTPUT_DIR=outputs
# 景点数据库路径（留空则用 mcp_server/data/attractions.db）
ATTRACTIONS_DB=
