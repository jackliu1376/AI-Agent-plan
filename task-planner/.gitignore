.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
outputs/*
!outputs/.gitkeep

# 会话库含用户任务原文与生成的计划，绝不入库
logs/

# uv.lock 必须提交：这是应用而不是库，部署时要靠它复现完全一致的依赖版本。
# （曾被忽略过，导致 CI 的缓存失效、服务器装的版本和本地不一致）
dist/
build/
*.egg-info/

# 自动生成的景点库（由 seed.py 重建）
mcp_server/data/attractions.db

# GeoNames 原始数据包缓存（3.3MB，用 build_city_index.py 重新下载即可）
mcp_server/data/.cache/


# 覆盖率数据（pytest-cov 生成，不入库）
.coverage
.coverage.*
htmlcov/
